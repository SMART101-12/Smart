# Copy to .env for local development. Never commit the real .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Existing SQLite store is reused by default (data/smart.db).
# SMART_DATA_ROOT=data
# SMART_SNAPSHOT_DB=data/smart.db
# Optional separate historical database; set deliberately to avoid a new cache.
# SMART_HISTORICAL_DB=data/historical/stocks.db
# SMART_FINANCIAL_CONFIG=config/financial_history.json
